# HTTP
PORT=8765

# Paths (auto-set in Docker; set manually for local dev)
DOCS_ROOT=../docs/modules/ROOT/pages
PARTIALS_ROOT=../docs/modules/ROOT/partials
EXAMPLES_ROOT=../docs/modules/ROOT/examples

# Embeddings cache
DATA_DIR=./data

# Embedding provider: openai | gemini
EMBEDDING_PROVIDER=openai

# OpenAI (required if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small

# Gemini (required if EMBEDDING_PROVIDER=gemini)
# GEMINI_API_KEY=...

# MCP Auth (required in production)
MCP_AUTH_TOKEN=changeme

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=info
