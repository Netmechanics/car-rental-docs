{
  "name": "nmecar-docs-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest:dump": "tsx src/ingest/dump.ts",
    "smoke": "node --env-file=.env --import tsx/esm test/smoke.ts"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.4",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "html-to-text": "^9.0.5",
    "openai": "^4.104.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
