    {
      "id": "claim_af1b902c3c874f3c9d24d87c4307e8d6",
      "statement": "The extension registers both a block and a block macro for a broad set of diagram types (plantuml, mermaid, graphviz, ditaa, blockdiag, seqdiag, actdiag, nwdiag, c4plantuml, erd, excalidraw, vega, vegalite, wavedrom, etc.), accepting both .... (literal) and ---- (listing) delimiters for the block form; the default output format is svg, overridable per-block or via kroki-default-format, and txt/atxt/utxt formats produce a literal text block instead of an image.",
      "evidence": [
        {
          "resource": "repo://node_modules/asciidoctor-kroki/src/asciidoctor-kroki.js#L118-L153",
          "version": "repo-lines-v1:sha256:9560c236f43c8bd16f5dad2891c26a09e31e62337d1d45246a1764ce03de0826:"
