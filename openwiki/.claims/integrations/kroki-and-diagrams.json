    {
      "id": "claim_dbfca879b91b41fa8fa6a3b7cbeb1436",
      "statement": "KROKI_BLOCK_RE matches the attribute line [plantuml|mermaid|graphviz|ditaa|blockdiag|seqdiag|actdiag|nwdiag|packetdiag|rackdiag|c4plantuml|erd|excalidraw|nomnoml|pikchr|structurizr|svgbob|umlet|vega|vegalite|wavedrom] (with optional trailing attributes) followed by either .... or ---- delimiters and removes the whole block; the type list is intentionally broader than the types currently used so future diagram types are also stripped.",
