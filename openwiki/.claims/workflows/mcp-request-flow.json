      "id": "claim_36d5b651e596487d86df4193cb2a1685",
      "statement": "createHttpApp builds an Express app exposing GET /health returning {status:'ok'} (mounted before auth and not under /mcp) and an ALL /mcp entrypoint that applies authMiddleware and, per request, constructs a fresh McpServer plus a session-id-less StreamableHTTPServerTransport, calls mcpServer.connect(transport) then transport.handleRequest(req, res, req.body), catching and 500-ing failures only when headers are not yet sent.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/mcp/httpTransport.ts#L42-L71",
          "version": "repo-lines-v1:sha256:5f2a565603ba92d5b5760c886710feed72e11f2968336ab41da89b7a41e4662e:"
        }
      ]
    },
