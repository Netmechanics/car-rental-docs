    {
      "id": "claim_81eb0333552a4cc58dafbd5a819b163f",
      "statement": "The live smoke script (`npm run smoke`, `test/smoke.ts`) requires a server already running on PORT (default 8765) with `MCP_AUTH_TOKEN` set; it pings `/health`, then for each of ten Greek queries posts a `tools/call` request for `search_nmecar_docs` with k=5, parses the SSE `data:` line, and checks the expected page at top-1 and within top-3, passing only when top-1 ≥ 6/10 and top-3 ≥ 8/10.",
      "evidence": [
        {
          "resource": "repo://mcp-server/package.json#L13-L13",
          "version": "repo-lines-v1:sha256:4b70707932cbf7579263432b2e11510f3046bcc6a04b7518abe3ffa6bbf535d4:"
