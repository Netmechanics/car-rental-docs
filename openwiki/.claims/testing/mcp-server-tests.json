    {
      "id": "claim_ad19ec5dbe1043d580126f73f5a1de8d",
      "statement": "`chunk.test.ts` asserts that `chunkPage` produces at least one chunk for any non-empty page, that chunks have unique ids, that the first chunk's text contains the page title (because a `«title»` or `«title › heading»` context prefix is prepended), that no chunk's `tokensApprox` exceeds ~1100 (guarding the MAX_TOKENS=800 paragraph split), that `tokensApprox` equals `Math.ceil(text.length/4)`, and that each chunk's `relPath` matches the input page.",
      "evidence": [
