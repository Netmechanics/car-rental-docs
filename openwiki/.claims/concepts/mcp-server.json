    {
      "id": "claim_f60f07fb339e490e86f3ce9a1cacfc85",
      "statement": "Auth middleware: if MCP_AUTH_TOKEN is unset the middleware passes through (local dev); if set it requires Authorization: Bearer <token> and returns 401 on mismatch. /health is registered before the auth-protected route and is exempt.",
