    {
      "id": "claim_ee8d96f8d4ef47a4b9389f0c121b0f3f",
      "statement": "list_doc_sections takes no input and returns { pages: [{ path, title, sections }] } grouped and deduplicated by relPath from chunk metadata, with non-empty section headings collected per page in chunk order.",
