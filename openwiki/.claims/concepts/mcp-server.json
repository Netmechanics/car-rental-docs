        }
      ]
    },
    {
      "id": "claim_4ab2c8601047481691e1c933995325fa",
      "statement": "get_doc_page takes path (string, min length 1) and returns { path, title, text } where text is the page's chunks joined with \\n\\n---\\n\\n; for a path with no matching chunk it returns isError:true with { error: 'Page not found: …' } rather than crashing, and the page is reconstructed from indexed chunks (not re-rendered from source).",
      "evidence": [
