  "claims": [
    {
      "id": "claim_0d2f430508bb47bab0e117eeb6d8160b",
      "statement": "The nmecar docs MCP server is a custom, retrieval-only service under mcp-server/ that turns the AsciiDoc corpus into a searchable vector index at startup and exposes it through MCP tools over Streamable HTTP; it does not perform LLM generation or answer synthesis (that belongs to a future, separate AI agent).",
      "evidence": [
        {
          "resource": "repo://MCP_SERVER_PLAN.md#L14-L31",
          "version": "repo-lines-v1:sha256:6a7daaf4f492ac387c3a6e73ca575a3d73a2c8ccc295f7b598195a9db77babfa:"
        },
        {
          "resource": "repo://mcp-server/README.md",
          "version": "repo-file-v1:sha256:28107212bae661ab089a256ccd8310bf4cfb21293f4e695237a0eb89e15b0210"
        },
        {
          "resource": "repo://mcp-server/src/index.ts",
          "version": "repo-file-v1:sha256:164c26a29e719c22896760713fd752cfed7aa376b7e8a9d8b8f80dd273a0c64f"
        }
      ]
    },
    {
      "id": "claim_bb0d67fe1ab14123b619692672b0c188",
      "statement": "At startup, src/index.ts runs a single sequential pipeline: loadAdoc → per-file resolveMacros+renderAdoc+chunkPage → contentHash → VectorStore.loadFromDisk (cache hit) or build+saveToDisk → createHttpApp listen; the HTTP server only starts after the index is ready.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/index.ts#L13-L53",
          "version": "repo-lines-v1:sha256:8d988c3d12024b8be6e9511d00099a11bd54e4c0f9cff57990e49bb934849f3d:"
        }
      ]
    },
    {
      "id": "claim_ba23d875b59842aeadec46464ac9af20",
      "statement": "loadAdoc walks DOCS_ROOT for .adoc files and skips stub pages (fewer than 50 non-whitespace characters after the first = Heading line), returning { path, relPath, raw } per surviving file.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/ingest/loadAdoc.ts#L10-L30",
          "version": "repo-lines-v1:sha256:dd7fa1aea672bc53c057e592151c74f58c5bbb77b19d77b6a89bb5f86e4f4362:"
        }
      ]
    },
    {
      "id": "claim_81309ed42e7140a2ad5810ca83ec83d0",
      "statement": "resolveMacros preprocesses Antora macros before rendering: it removes Kroki diagram blocks, recursively inlines partial$ includes (skipping nav_* partials) up to max depth 10, inlines example$ includes wrapped in a source code fence, and replaces xref: and image:: with their link/alt text (or drops them when empty).",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/ingest/resolveMacros.ts#L1-L87",
          "version": "repo-lines-v1:sha256:b8ce5452589b98bfc727c6551e1e3bc4d6fa3e69c950e87c7fe483bbad555914:"
        }
      ]
    },
    {
      "id": "claim_3715aa8ae5b04efe9792503e9dc52957",
      "statement": "renderAdoc converts preprocessed AsciiDoc to HTML via @asciidoctor/core (safe:'safe', standalone:false) then to plain text via html-to-text, and derives the page title from the first = Heading line (falling back to relPath).",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/ingest/render.ts#L1-L32",
          "version": "repo-lines-v1:sha256:f24472b1efacfe8051952db1734cda898022bf47fc58b7a511eda63114a392df:"
        }
      ]
    },
    {
      "id": "claim_1d4b36c112bc484799205e895ac97f81",
      "statement": "chunkPage splits each rendered page into metadata-bearing chunks, prefixes each chunk's text with a «pageTitle › sectionHeading» context prefix, bounds chunk size (target ≤800 tokens, splits oversized chunks by paragraph, merges tiny consecutive chunks under 80 tokens), and assigns each chunk a stable id of the form relPath#slug-index.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/ingest/chunk.ts#L42-L158",
          "version": "repo-lines-v1:sha256:79007e569ad959e71c6f20fd5a52c06bf56b7ce5959b3bb5a745559f5570d672:"
        }
      ]
    },
    {
      "id": "claim_b4f68e174e5e466dad93faaf3d9439d6",
      "statement": "contentHash computes a sha256 over the chunk texts sorted by id, concatenated with a hardcoded PIPELINE_VERSION and the embedding model name; it is used both as the cache file name and the cache-validity gate, so changes to chunk text, pipeline version, or embedding model invalidate the cache.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/index.ts#L34-L45",
          "version": "repo-lines-v1:sha256:a9446ccf161391d13cf928f538ee62b5aa5a671bd576ba93e938bb9ed3b87bb9:"
        },
        {
          "resource": "repo://mcp-server/src/indexing/hash.ts#L1-L10",
          "version": "repo-lines-v1:sha256:fb2f6d511bb59f6a1da7496bd6a13b8b94405ac01942a24ede3281199ee97859:"
        }
      ]
    },
    {
      "id": "claim_9bcc30b7841647a6bc76027edb397fba",
      "statement": "The corpus is small (~40 Greek pages, ~15,400 words), which justifies an in-memory vector store with cosine similarity over an external vector database.",
      "evidence": [
        {
          "resource": "repo://MCP_SERVER_PLAN.md#L260-L271",
          "version": "repo-lines-v1:sha256:61d43c39bf5a60f2680b819f80b8691f5aa24c1b749e8c4a8b06e3e71845776a:"
        },
        {
          "resource": "repo://MCP_SERVER_PLAN.md#L32-L34",
          "version": "repo-lines-v1:sha256:e8c9b837f2e6451144c9f98d202d5836c07b6bf6f460716b0b12a9c2e87b945b:"
        }
      ]
    },
    {
      "id": "claim_7a8a2834a2214c2ab5a87990a163a494",
      "statement": "VectorStore holds an in-memory StoredVector[]; vectors are L2-normalized to unit length at build time so search reduces to a dot product, computed linearly over all vectors, sorted descending, and truncated to k.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/indexing/store.ts#L18-L53",
          "version": "repo-lines-v1:sha256:8d7162dc1c83488c794c8235e955fafe92e48dab170549ca55d0e0e3e4cf6a2b:"
        }
      ]
    },
    {
      "id": "claim_e53de84f2cdd45be810f932aeeb32317",
      "statement": "VectorStore persistence is a single JSON file per content hash at ${DATA_DIR}/index-${hash}.json containing { hash, vectors }; loadFromDisk returns null on read/parse error or hash mismatch, which the startup path treats as a cache miss and triggers a rebuild. Old cache files for stale hashes are left on disk and ignored, not garbage-collected.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/index.ts#L37-L45",
          "version": "repo-lines-v1:sha256:6b53fde1c60b951dd6f7834f5143d28bb34f81f1d5e589ef613f276ed5774a3c:"
        },
        {
          "resource": "repo://mcp-server/src/indexing/store.ts#L55-L76",
          "version": "repo-lines-v1:sha256:47353bacc88fc23ed24d8bb94fdced28c5d26bef3aabbdb0c3e94867e79c776e:"
        }
      ]
    },
    {
      "id": "claim_5a08c9b2c0bd47909de6865b53b1286f",
      "statement": "The Embedder interface is provider-agnostic ({ model, dims, embed(texts) }); the default and only implemented provider is OpenAI text-embedding-3-small (1536 dims, batched ≤100 per request with retry/backoff on 429/5xx), selected via EMBEDDING_PROVIDER. Gemini is a documented alternative but createEmbedder throws for it (not yet implemented).",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/indexing/embed.ts#L1-L66",
          "version": "repo-lines-v1:sha256:9c61626f637e72035ef2bda15f6efc6f92ba3fdd3e8899bf61ec5b72d915fecf:"
        }
      ]
    },
    {
      "id": "claim_eee48cdcc6504dafad0c3289afcc29b6",
      "statement": "buildMcpServer constructs an McpServer named nmecar-docs (version 0.1.0) and registers exactly three retrieval tools: search_nmecar_docs, get_doc_page, and list_doc_sections, each with a zod input schema and a JSON-serialized payload in a single text content part.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/mcp/server.ts#L9-L68",
          "version": "repo-lines-v1:sha256:2d24ec927d8cc700720ea4aeecca66dc647abb28ca60dc8d9d2844c5e5436046:"
        }
      ]
    },
    {
      "id": "claim_5ffdf7bd67b84f73a00bae69683b39bf",
      "statement": "search_nmecar_docs takes query (string, min length 1) and optional k (int 1–20, default 5), embeds the query with the same embedder used to build the index, runs store.search, and returns { results: [{ page, title, section, score, text }] } with score rounded to 3 decimals; it returns an empty results array rather than isError for a valid query with no hits.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/mcp/server.ts#L12-L27",
          "version": "repo-lines-v1:sha256:e6fa3c298068d2d0d3102133637bcde6f74469da285b34aca1ee90e2fb5e9e6e:"
