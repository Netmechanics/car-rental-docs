        },
        {
          "resource": "repo://mcp-server/src/indexing/store.ts#L55-L76",
          "version": "repo-lines-v1:sha256:47353bacc88fc23ed24d8bb94fdced28c5d26bef3aabbdb0c3e94867e79c776e:"
        }
      ]
    },
    {
      "id": "claim_793a76ee80ee4f0fb5d4f7d84c34d057",
      "statement": "The vector cache file is named index-<hash>.json and loadFromDisk verifies the stored hash field equals the expected hash before using it, so stale indexes for changed content/model are ignored rather than reused.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/indexing/store.ts#L55-L76",
