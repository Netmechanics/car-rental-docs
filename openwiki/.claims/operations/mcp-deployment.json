        }
      ]
    },
    {
      "id": "claim_920adb59915743f496e2d97abcf16b25",
      "statement": "The image declares VOLUME [\"/data\"], EXPOSE 8765, an in-image HEALTHCHECK that fetches http://localhost:8765/health every 30s, and runs `node dist/index.js`.",
      "evidence": [
        {
          "resource": "repo://mcp-server/Dockerfile#L32-L38",
          "version": "repo-lines-v1:sha256:29507f95ab8d5eab272d69df8765bb436835399e8933b4cd61cf2baee6ce08b3:"
        }
