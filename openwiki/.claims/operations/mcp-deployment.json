    {
      "id": "claim_1e4ef84cb4564f7aa1e330003dd59ca6",
      "statement": "At startup src/index.ts loads docs, chunks them, computes a content hash over sorted chunk texts plus PIPELINE_VERSION and the embedder model, and attempts to load /data/index-<hash>.json; on a cache hit it hydrates the VectorStore without calling the embeddings API, on a miss it builds and saves the index.",
      "evidence": [
        {
          "resource": "repo://mcp-server/src/index.ts#L16-L45",
          "version": "repo-lines-v1:sha256:f02568169c67a0b718d24c221f0f50540b0bf4ca4a634cab9e05af404bf83247:"
        },
        {
