    {
      "id": "claim_b49aee88a2f344ba83d64c45af0a291a",
      "statement": "On first boot (cache miss) the MCP server computes a content hash over the chunked content plus the embedding model and, failing to find a cached index, builds the vector index by calling the embeddings API in batches, then persists the index to `DATA_DIR`; a cache hit on subsequent boots loads the index from disk without calling the API.",
      "evidence": [
        {
          "resource": "repo://mcp-server/README.md#L45-L48",
          "version": "repo-lines-v1:sha256:18a6f4493d184fd65b12dd1bdf86eca7bcf405184f5d793e4d8140c4d9098ee4:"
        },
