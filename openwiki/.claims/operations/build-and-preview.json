    {
      "id": "claim_4fdbdbd57a4b49c0841b17643431fe33",
      "statement": "The MCP server's local-dev content roots in `.env.example` point at the Antora corpus relative to `mcp-server/`: `DOCS_ROOT=../docs/modules/ROOT/pages`, `PARTIALS_ROOT=../docs/modules/ROOT/partials`, `EXAMPLES_ROOT=../docs/modules/ROOT/examples`; `DATA_DIR=./data` is the local embeddings cache.",
      "evidence": [
        {
          "resource": "repo://mcp-server/.env.example#L1-L11",
